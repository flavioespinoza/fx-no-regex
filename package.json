{
  "name": "fx-no-regex",
  "version": "1.0.0",
  "description": "String utilities that replace common regex patterns with plain string operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/modules"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && node --test \"dist/**/*.test.js\"",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "keywords": [
    "regex",
    "no-regex",
    "string",
    "typescript",
    "esm"
  ],
  "author": "Flavio Espinoza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flavioespinoza/fx-no-regex.git"
  },
  "homepage": "https://github.com/flavioespinoza/fx-no-regex#readme",
  "bugs": {
    "url": "https://github.com/flavioespinoza/fx-no-regex/issues"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
